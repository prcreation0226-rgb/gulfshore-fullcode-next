# Twilio (SMS Automation)
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_NUMBER=+12399929119

# Resend (Email Alerts)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Dimitri Schwarz <alerts@gulfshoregroup.com>

# Admin Configuration
ADMIN_ALERT_EMAIL=dimitri@gulfshoregroup.com
ADMIN_ALERT_PHONE=+12399929119
PROPERTY_ALERTS_API_SECRET=gulfshore-secret-2024

# Cloudinary (Image Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Application
NEXT_PUBLIC_SERVER_URL=https://gulfshoregroup.com

# Cron Jobs
CRON_SECRET=your-cron-secret

# Clerk (Authentication)
